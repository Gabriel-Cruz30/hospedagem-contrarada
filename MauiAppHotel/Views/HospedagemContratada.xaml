
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Hospedagem Contratada"
             BackgroundColor="#F2F4F8">

    <VerticalStackLayout Padding="20"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="Hospedagem Confirmada!"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="#315B8A" />

        <Label Text="Sua solicitação de hospedagem foi registrada."
               FontSize="18"
               HorizontalTextAlignment="Center" />

        <Label Text="Obrigado por escolher nosso hotel!"
               FontSize="16"
               HorizontalTextAlignment="Center" />

        <Button Text="Voltar"
                Clicked="Voltar_Clicked" />

        <Button Text="Sobre"
                Clicked="Sobre_Clicked" />

    </VerticalStackLayout>
</ContentPage>

