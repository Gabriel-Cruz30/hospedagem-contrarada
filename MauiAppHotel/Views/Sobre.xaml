

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#F2F4F8">

    <VerticalStackLayout Padding="25"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="SOBRE O APLICATIVO"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="#315B8A" />

        <Label Text="Aplicativo Hotel"
               FontSize="22"
               HorizontalTextAlignment="Center" />

        <Label Text="Desenvolvedor:"
               FontSize="18"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <Label Text="Gabriel Soares da Cruz"
               FontSize="18"
               HorizontalTextAlignment="Center" />

        <Label Text="Ano de desenvolvimento: 2026"
               FontSize="18"
               HorizontalTextAlignment="Center" />

        <Button Text="Voltar"
                Clicked="Voltar_Clicked" />

    </VerticalStackLayout>
</ContentPage>
