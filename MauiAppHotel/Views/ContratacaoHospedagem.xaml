
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Contratação de Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F2F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <Label Text="Cálculo da Diária"
                   FontFamily="Kalam"
                   FontSize="35"
                   HorizontalOptions="Center"
                   TextColor="#315B8A" />

            <Frame Padding="12">
                <VerticalStackLayout Spacing="12">

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*,2*"
                          RowSpacing="12">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:" />

                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Value, Source={x:Reference stp_adultos}}" />

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:" />

                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Value, Source={x:Reference stp_criancas}}" />

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>

                    <Frame Padding="10">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="Escolha sua Suíte"
                                   FontSize="18"
                                   TextColor="#315B8A" />

                            <Picker x:Name="pck_quarto"
                                    Title="Selecione sua acomodação" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Padding="10">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="Período da Estadia"
                                   FontSize="18"
                                   TextColor="#315B8A" />

                            <Label Text="Check-in:" />

                            <DatePicker x:Name="dtpck_checkin"
                                        Format="dd/MM/yyyy" />

                            <Label Text="Check-out:" />

                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="Avançar"
                            Clicked="Avancar_Clicked"
                            BackgroundColor="#315B8A"
                            TextColor="White"
                            CornerRadius="10" />

                    <Button Text="Sobre"
                            Clicked="Sobre_Clicked"
                            BackgroundColor="#607D8B"
                            TextColor="White" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

